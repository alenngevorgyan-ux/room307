extends Node
## Bus — signals only. Every system talks through it.
## IDs are plain Strings (see docs/PROGRESS.md "Decisions": String ids, not StringName).

# --- STATE_MODEL §1 (gameplay) ---
signal fact_learned(fact_id: String, source: String)
signal observation_noticed(obs_id: String)
signal thread_offered(thread_id: String)
signal thread_pinned(thread_id: String)
signal claim_spoken(claim_id: String, speaker: String, addressee: String, audience: Array)
signal npc_reaction(npc_id: String, reaction: String)
signal exchange_started(exchange_id: String)
signal exchange_ended(exchange_id: String, outcome: String)
signal item_changed(item_id: String, holder: String)
signal stage_point_changed(point_id: String, value: String)
signal world_beat(beat_id: String)
signal player_detected(by_npc: String, severity: int)
signal player_decision(kind: String)
signal ending_reached(ending_id: String)

# --- additions (logged as a Decision): state/presentation glue ---
signal flag_changed(flag: String, value: Variant)
signal lead_changed(lead: String, state: int)
signal thread_struck(thread_id: String)
signal scene_changed(scene_id: String)
signal trap_fired(trap_id: String, outcome_index: int)
signal trap_bait(event: String, data: Dictionary)   # generic bait (house phone, silence, stage ...)

# presentation requests (no-ops in headless sims)
signal line_requested(line_key: String, ctx: Dictionary)
signal line_started(speaker: String, text: String, dur: float)
signal bark_requested(npc_id: String, text: String)
signal chips_shown(exchange_id: String, chips: Array, timeout: float)
signal chips_cleared()
signal caption_shown(obs_id: String, text: String, pos: Vector3)
signal hint_requested(text: String, dur: float)
signal thought_requested(text: String, dur: float)   # level-3 guidance: an EL thought (subtitle, italic)
signal phone_message(from: String, text: String)
signal cine_requested(cine_id: String)
signal cine_started(cine_id: String, dur: float)
signal cine_ended(cine_id: String)
signal sfx_requested(sfx_id: String, pos: Variant)
signal music_requested(state: String)
signal camera_hint(hint: Dictionary)
signal npc_command(npc_id: String, cmd: String, args: Dictionary)
signal npc_popped(npc_id: String, kind: String, info: Dictionary)   # QA: appeared/vanished/jumped on camera
signal tell_opened(obs_id: String, dur: float)
signal noise(pos: Vector3, radius: float, source: String)
signal fade_requested(dur: float)
signal control_lock(reason: String, locked: bool)
signal scene_requested(scene_id: String)
signal interact_done(interact_id: String)
