{
  "ADR_NAME": {"speaker": "adrian", "text": "Адриан Вейл."},
  "ADR_01": {"speaker": "adrian", "text": "Мне сказали, вы умеете находить людей."},
  "ADR_WARY": {"speaker": "adrian", "text": "Надеюсь, со мной вы будете деликатнее."},
  "ADR_LEFT_EARLY": {"speaker": "adrian", "text": "Вы ушли до самого интересного."},
  "H_01": {"speaker": "hero", "text": "Вам соврали."},
  "H_01B": {"speaker": "hero", "text": "Но продолжайте."},
  "ADR_WALK": {"speaker": "adrian", "text": "Пройдёмся."},
  "ADR_BRIEF_1": {"speaker": "adrian", "text": "Моя дочь. Мара. Двадцать четыре. Её номер — триста седьмой. Её там нет."},
  "ADR_BRIEF_2": {"speaker": "adrian", "text": "Её бывший. Лукас. Он шантажирует семью. Полиция исключена.", "tell": {"obs": "O_S2_NAME_PAUSE", "at": 0.9, "dur": 1.4}},
  "H_DANGER": {"speaker": "hero", "text": "Она в опасности?"},
  "ADR_FLAT": {"speaker": "adrian", "text": "Найдите её.", "tell": {"obs": "O_S2_FLAT_ON_DANGER", "at": 0.1, "dur": 2.2}},
  "H_NOPOLICE": {"speaker": "hero", "text": "Почему без полиции?"},
  "ADR_NOPOLICE": {"speaker": "adrian", "text": "Полиция — это газеты. Газеты — это конец."},
  "H_EXNAME": {"speaker": "hero", "text": "Имя бывшего?"},
  "ADR_EXNAME": {"speaker": "adrian", "text": "…Лукас. Лукас Ферро. Какая разница.", "tell": {"obs": "O_S2_NAME_PAUSE", "at": 0.0, "dur": 1.6}},
  "H_LEVERAGE": {"speaker": "hero", "text": "Чем бывший может шантажировать?"},
  "ADR_LEVERAGE": {"speaker": "adrian", "text": "Глупостями. Фотографиями. Неважно."},
  "H_TOOK": {"speaker": "hero", "text": "Что она взяла с собой?"},
  "ADR_TOOK": {"speaker": "adrian", "text": "Сумку. Телефон. Не знаю.", "tell": {"obs": "O_S2_POCKET_TOUCH", "at": 0.6, "dur": 1.8}},
  "H_WHO": {"speaker": "hero", "text": "Кто это?"},
  "ADR_WHO": {"speaker": "adrian", "text": "Мой человек. Не обращайте внимания."},
  "H_HOWMUCH": {"speaker": "hero", "text": "Сколько?"},
  "ADR_HOWMUCH": {"speaker": "adrian", "text": "Сколько скажете. В разумных пределах."},
  "H_NOT_FROM_EX": {"speaker": "hero", "text": "Если она прячется — то не от бывшего."},
  "ADR_NOT_FROM_EX": {"speaker": "adrian", "text": "…Найдите её."},
  "H_CALL_LIE": {"speaker": "hero", "text": "Вы мне врёте."},
  "ADR_CALL_LIE": {"speaker": "adrian", "text": "Я вам плачу. Это лучше, чем правда."},
  "H_LOST_HER": {"speaker": "hero", "text": "Вы её уже потеряли."},
  "ADR_LOST_HER": {"speaker": "adrian", "text": "…Не смейте."},
  "H_PRICE": {"speaker": "hero", "text": "Тогда это стоит вдвое больше."},
  "ADR_PRICE": {"speaker": "adrian", "text": "Втрое. Если до утра."},
  "H_CALLED": {"speaker": "hero", "text": "Она звонила мне час назад."},
  "ADR_GRAB": {"speaker": "adrian", "text": "Что она сказала?"},
  "H_DEFLECT_GRAB": {"speaker": "hero", "text": "Что ищет вас."},
  "ADR_AFTER_DEFLECT": {"speaker": "adrian", "text": "…Ищет. Конечно. Найдите её первым."},
  "H_ADMIT": {"speaker": "hero", "text": "Ничего. Мне нужно было увидеть ваше лицо."},
  "ADR_AFTER_ADMIT": {"speaker": "adrian", "text": "Увидели? Больше так не делайте."},
  "ADR_SILENT": {"speaker": "adrian", "text": "…"},
  "ADR_DEEP": {"speaker": "adrian", "text": "Была старая история. Авария. Ей было семнадцать, она спала сзади. Она ничего не помнит. Слава богу."},
  "ADR_KEY": {"speaker": "adrian", "text": "Триста седьмой. Дальше — вы."},
  "ADR_CALLBACK": {"speaker": "adrian", "text": "Триста седьмой. Ключ у меня."},
  "ADR_IMPATIENT": {"speaker": "adrian", "text": "Вы идёте?"},
  "RECEPT_KEY": {"speaker": "receptionist", "text": "Вам оставили ключ. Номер триста семь."}
}
