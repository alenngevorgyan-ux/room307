{
  "H_MARA_NAME": {"speaker": "hero", "text": "Мара."},
  "H_POLICE": {"speaker": "hero", "text": "Полиция уже едет."},
  "H_DANIEL_KNOWS": {"speaker": "hero", "text": "Дэниел знает, что ты здесь."},
  "H_THOMAS": {"speaker": "hero", "text": "Томас."},
  "TH_STEP_ASIDE": {"speaker": "thomas", "text": "Отойди."},
  "TH_KEYS": {"speaker": "thomas", "text": "Ключи. Отдай, парень."},
  "TH_DANIEL_SCAN": {"speaker": "thomas", "text": "Дэниел? Здесь? …Говори быстро."},
  "TH_SWEAR": {"speaker": "thomas", "text": "Чёрт. Чёрт! Заперли."},
  "TH_01": {"speaker": "thomas", "text": "Мне нечего тебе сказать."},
  "TH_POLICE": {"speaker": "thomas", "text": "Полиция? Тогда мне нечего терять."},
  "TH_SILENCE": {"speaker": "thomas", "text": "…Ты от него, да? От Вейла."},
  "TH_NAMED": {"speaker": "thomas", "text": "…Ты и это знаешь."},
  "H_TH_DRIVER": {"speaker": "hero", "text": "Ты был водителем Вейлов."},
  "TH_IAM": {"speaker": "thomas", "text": "Томас. Томас Рид. Возил их двенадцать лет."},
  "TH_BLAME": {"speaker": "thomas", "text": "Семь лет назад. Авария. Человек погиб. Я сидел полтора года."},
  "H_TH_FORWHOM": {"speaker": "hero", "text": "За кого сидел?"},
  "TH_CARDSHARK": {"speaker": "thomas", "text": "У тебя руки картёжника."},
  "TH_NOTME": {"speaker": "thomas", "text": "За рулём был не я."},
  "H_TH_ADRIAN": {"speaker": "hero", "text": "Адриан."},
  "H_TH_SON": {"speaker": "hero", "text": "Твой сын?"},
  "TH_SON": {"speaker": "thomas", "text": "Деньги Вейла вытащили моего сына. Я согласился сам. Слышишь? Сам."},
  "TH_CARD": {"speaker": "thomas", "text": "У неё запись. С камеры в машине. Я сам её поставил. Идиот."},
  "TH_FORGOT": {"speaker": "thomas", "text": "Адриан думает, она ничего не помнит. Она спала. Он так и сказал Дэниелу: пусть спит дальше."},
  "TH_STOP": {"speaker": "thomas", "text": "Останови её."},
  "H_FROM_WHAT": {"speaker": "hero", "text": "От чего?"},
  "TH_JUSTICE": {"speaker": "thomas", "text": "От справедливости."},
  "TH_GO": {"speaker": "thomas", "text": "Уходи. Они не за мной."}
}
